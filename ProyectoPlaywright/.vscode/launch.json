{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug: @purchase",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber-js",
            "args": [
                "--require-module",
                "ts-node/register",
                "--require",
                "tests/cucumber/**/*.ts",
                "tests/features/**/*.feature",
                "--tags",
                "@purchase"
            ],
            "env": {
                "PWDEBUG": "1",
                "HEADLESS": "false"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug: @datepicker",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber-js",
            "args": [
                "--require-module",
                "ts-node/register",
                "--require",
                "tests/cucumber/**/*.ts",
                "tests/features/**/*.feature",
                "--tags",
                "@datepicker"
            ],
            "env": {
                "PWDEBUG": "1",
                "HEADLESS": "false"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}